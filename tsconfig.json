{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"] // This mapping is relative to "baseUrl".
    },
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "bdd",
    "setup",
    "playwright.config.ts"
  ],
  // *.check.ts are standalone `node --experimental-strip-types` scripts (they use
  // .ts import specifiers + top-level await that the app tsconfig disallows).
  "exclude": [
    "**/*.check.ts"
  ]
}
