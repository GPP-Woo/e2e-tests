# GPP-publicatiebank (ODRC) REST API — used to own publicaties/documenten/organisaties
# test data (TS6-9). Defaults to GPP_PUBLICATIEBANK_BASE_URL when ODRC_BASE_URL is unset.
ODRC_BASE_URL=
ODRC_API_KEY=
